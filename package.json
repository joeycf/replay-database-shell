{
  "name": "replay-database-shell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Replay Database selector shell: the apex (replaydatabase.com) landing page that routes /2xko and /tekken to the game apps. A thin consumer of the replay-engine layer with NO theme.css — it wears the engine's neutral umbrella brand.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && nuxt typecheck",
    "lint": "nuxt prepare && eslint .",
    "lint:fix": "nuxt prepare && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:shell": "node scripts/verify-shell.mjs",
    "verify:cutover": "node scripts/verify-cutover.mjs"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "nuxt": "^4.4.8",
    "prettier": "^3.9.5",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "@vercel/analytics": {
      "vue-router": "^5"
    },
    "@vercel/speed-insights": {
      "vue-router": "^5"
    }
  },
  "engines": {
    "node": ">=24 <25"
  }
}
