{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run generate",
  "framework": "nuxtjs",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/champions/:path*",
      "destination": "/2xko/champions/:path*",
      "permanent": true
    },
    {
      "source": "/players/:path*",
      "destination": "/2xko/players/:path*",
      "permanent": true
    },
    {
      "source": "/stats",
      "destination": "/2xko/stats",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/2xko",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "c"
        }
      ],
      "destination": "/2xko",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "p"
        }
      ],
      "destination": "/2xko",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "side"
        }
      ],
      "destination": "/2xko",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "q"
        }
      ],
      "destination": "/2xko",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "sort"
        }
      ],
      "destination": "/2xko",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "fuse"
        }
      ],
      "destination": "/2xko",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "src"
        }
      ],
      "destination": "/2xko",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "patch"
        }
      ],
      "destination": "/2xko",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "ch"
        }
      ],
      "destination": "/2xko",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "s"
        }
      ],
      "destination": "/2xko",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "type"
        }
      ],
      "destination": "/2xko",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/2xko-insights/:path*",
      "destination": "https://2xko-replay-database.vercel.app/_vercel/insights/:path*"
    },
    {
      "source": "/tekken-insights/:path*",
      "destination": "https://tekken-replay-database.vercel.app/_vercel/insights/:path*"
    },
    {
      "source": "/sf6-insights/:path*",
      "destination": "https://sf6-replay-database.vercel.app/_vercel/insights/:path*"
    },
    {
      "source": "/tokon-insights/:path*",
      "destination": "https://tokon-replay-database.vercel.app/_vercel/insights/:path*"
    },
    {
      "source": "/ffcotw-insights/:path*",
      "destination": "https://ffcotw-replay-database.vercel.app/_vercel/insights/:path*"
    },
    {
      "source": "/ggst-insights/:path*",
      "destination": "https://ggst-replay-database.vercel.app/_vercel/insights/:path*"
    },
    {
      "source": "/gbvsr-insights/:path*",
      "destination": "https://gbvsr-replay-database.vercel.app/_vercel/insights/:path*"
    },
    {
      "source": "/avatar-insights/:path*",
      "destination": "https://avatar-replay-database.vercel.app/_vercel/insights/:path*"
    },
    {
      "source": "/2xko",
      "destination": "https://2xko-replay-database.vercel.app/2xko"
    },
    {
      "source": "/2xko/:path*",
      "destination": "https://2xko-replay-database.vercel.app/2xko/:path*"
    },
    {
      "source": "/tekken",
      "destination": "https://tekken-replay-database.vercel.app/tekken"
    },
    {
      "source": "/tekken/:path*",
      "destination": "https://tekken-replay-database.vercel.app/tekken/:path*"
    },
    {
      "source": "/sf6",
      "destination": "https://sf6-replay-database.vercel.app/sf6"
    },
    {
      "source": "/sf6/:path*",
      "destination": "https://sf6-replay-database.vercel.app/sf6/:path*"
    },
    {
      "source": "/tokon",
      "destination": "https://tokon-replay-database.vercel.app/tokon"
    },
    {
      "source": "/tokon/:path*",
      "destination": "https://tokon-replay-database.vercel.app/tokon/:path*"
    },
    {
      "source": "/ffcotw",
      "destination": "https://ffcotw-replay-database.vercel.app/ffcotw"
    },
    {
      "source": "/ffcotw/:path*",
      "destination": "https://ffcotw-replay-database.vercel.app/ffcotw/:path*"
    },
    {
      "source": "/ggst",
      "destination": "https://ggst-replay-database.vercel.app/ggst"
    },
    {
      "source": "/ggst/:path*",
      "destination": "https://ggst-replay-database.vercel.app/ggst/:path*"
    },
    {
      "source": "/gbvsr",
      "destination": "https://gbvsr-replay-database.vercel.app/gbvsr"
    },
    {
      "source": "/gbvsr/:path*",
      "destination": "https://gbvsr-replay-database.vercel.app/gbvsr/:path*"
    },
    {
      "source": "/avatar",
      "destination": "https://avatar-replay-database.vercel.app/avatar"
    },
    {
      "source": "/avatar/:path*",
      "destination": "https://avatar-replay-database.vercel.app/avatar/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:game(2xko|tekken|sf6|tokon|ffcotw|ggst|gbvsr|avatar)/:dir(icons|partners)/:path+",
      "headers": [{ "key": "Vercel-CDN-Cache-Control", "value": "max-age=86400" }]
    },
    {
      "source": "/:game(2xko|tekken|sf6|tokon|ffcotw|ggst|gbvsr|avatar)/:file(favicon\\.ico|favicon\\.svg|manifest\\.webmanifest)",
      "headers": [{ "key": "Vercel-CDN-Cache-Control", "value": "max-age=86400" }]
    },
    {
      "source": "/:game(2xko|tekken|sf6|tokon|ffcotw|ggst|gbvsr|avatar)/img/:path+",
      "headers": [{ "key": "Vercel-CDN-Cache-Control", "value": "max-age=3600" }]
    },
    {
      "source": "/:game(2xko|tekken|sf6|tokon|ffcotw|ggst|gbvsr|avatar)/og-default.png",
      "headers": [{ "key": "Vercel-CDN-Cache-Control", "value": "max-age=3600" }]
    },
    {
      "source": "/:game(2xko|tekken|sf6|tokon|ffcotw|ggst|gbvsr|avatar)/data/:file+",
      "headers": [{ "key": "Vercel-CDN-Cache-Control", "value": "max-age=300" }]
    }
  ]
}
